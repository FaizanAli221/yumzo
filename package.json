{
  "name": "yummzo-foods-api",
  "version": "1.0.0",
  "description": "Production-ready REST API for Yummzo Foods — an FMCG/D2C snack e-commerce platform. Built with Express, deployed as Vercel Serverless Functions.",
  "main": "server.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "vite",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "preview": "vite preview",
    "vercel-dev": "vercel dev",
    "lint": "node --check server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "lucide-react": "^0.344.0",
    "morgan": "^1.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6"
  },
  "keywords": [
    "express",
    "rest-api",
    "vercel-serverless",
    "fmcg",
    "ecommerce",
    "nodejs"
  ]
}
